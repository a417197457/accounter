# 复制到 ECS 的 /etc/accounter/env，替换占位值后执行 chmod 600。
SERVER_PORT=8080
DB_DRIVER=mysql
DB_HOST=RDS_PRIVATE_ENDPOINT
DB_PORT=3306
DB_USER=accounter
DB_PASSWORD=CHANGE_ME
DB_NAME=accounter

# 至少 32 位随机值：openssl rand -hex 32
JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET
JWT_EXPIRE=168h

# H5 与 API 同域时无需 CORS；分域时用逗号分隔网页 Origin。
CORS_ALLOWED_ORIGINS=

WECHAT_APP_ID=wx6339d0862921ce0e
WECHAT_APP_SECRET=CHANGE_ME

AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=CHANGE_ME
AI_MODEL=qwen-max
AI_ASR_BASE_URL=
AI_ASR_API_KEY=
AI_ASR_MODEL=qwen3-asr-flash

# 激活码 HMAC 密钥，必须长期保持不变：openssl rand -hex 32
AI_ACTIVATION_SECRET=CHANGE_TO_ANOTHER_RANDOM_SECRET
AI_TRIAL_DAYS=7
AI_TRIAL_DAILY_LIMIT=50
AI_ACTIVATED_DAILY_LIMIT=500
AI_ACTIVATION_ATTEMPT_LIMIT=5
AI_ACTIVATION_IP_ATTEMPT_LIMIT=30
